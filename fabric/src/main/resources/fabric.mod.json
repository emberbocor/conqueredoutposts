{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Claim pillager outposts by placing a banner in them: a claimed outpost stops spawning pillagers. Only needed on the server.",
  "authors": [
    "Ember Bocor"
  ],
  "contact": {
    "homepage": "https://github.com/emberbocor/conqueredoutposts",
    "sources": "https://github.com/emberbocor/conqueredoutposts",
    "issues": "https://github.com/emberbocor/conqueredoutposts/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.emberbocor.conqueredoutposts.ConqueredOutpostsFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "${fabric_api_version_range}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=25"
  }
}
